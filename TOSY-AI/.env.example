SECRET_KEY=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:5000
DATABASE_PATH=tosy.db

# Automatic provider selection. TOSY tries configured keys in this order,
# then falls back to the next provider if a request fails.
AI_PROVIDER_STRATEGY=automatic
AI_PROVIDER_ORDER=gemini,openai,openrouter
GEMINI_API_KEY=
GEMINI_FREE_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions


# Payments intentionally remain disabled until checkout and signed webhooks exist.
PAYMENTS_ENABLED=false
